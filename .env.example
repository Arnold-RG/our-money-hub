# Our Money Hub — example settings. Copy to .env (compose) or backend/.env (local) and fill in.
# Never commit real values. Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENV=development                 # development | test | production (production requires PostgreSQL)
DATABASE_URL=postgresql+psycopg://omh@127.0.0.1:5433/omh_db   # omit locally to use a SQLite file
OMH_DB_PASSWORD=                    # docker compose only
OMH_SECRET_KEY=                     # required outside development
OMH_FIELD_KEY=                      # optional separate key for encrypted fields (MFA secrets)
CORS_ORIGINS=http://localhost:3420,http://127.0.0.1:3420
COOKIE_SECURE=false                 # true behind HTTPS
ALLOW_REGISTRATION=false            # closed by default
OMH_OWNER_SETUP_TOKEN=              # one-time token to create the owner on an empty database; unset = fully closed
DEMO_LOGIN_ENABLED=false            # private, empty throwaway workspaces; honoured only when APP_ENV=development
RATES_AUTO_SYNC=true                # refresh NBP / ECB / BNR rates every 6 hours while the API runs
# GitHub OAuth (optional; leave empty to hide the button)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password-reset email (optional)
RESEND_API_KEY=
MAIL_FROM=

REGISTRATION_MODE=closed
