{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arnova.group/ecosystem/schemas/event.schema.json",
  "title": "Arnova ecosystem event envelope (master spec §10)",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "source", "organization_id", "occurred_at", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "event_type": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$"},
    "source": {"enum": ["ragi", "omh", "github", "monitoring", "arnovagroup", "movies"]},
    "organization_id": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {"type": "object"}
  }
}
